# Senha para entrar em /admin (defina uma senha forte).
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor aleatório, ex: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-grande

# URL final do site (sem barra no final). Usada em SEO, sitemap, canonical, OG.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Preenchidas automaticamente pela Vercel quando você conecta o
# armazenamento "KV" ao projeto — não precisa definir manualmente.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
